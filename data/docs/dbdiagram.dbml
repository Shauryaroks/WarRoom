// ============================================================================
// TEAMS
// ============================================================================

Table teams {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(50) [not null, unique]
  ticker varchar(5) [not null, unique]
  api_key uuid [unique, default: `gen_random_uuid()`]

  status varchar(20) [default: 'PENDING']
  portfolio_id varchar(50)
  swot_profile jsonb

  cash decimal(15,2) [default: 1000000.00]
  stock_price decimal(10,2) [default: 100.00]
  shares_outstanding integer [default: 1000000]
  public_float integer [default: 100000]
  max_treasury_sale_pct decimal(5,2) [default: 10.00]
  treasury_sold_this_stage decimal(5,2) [default: 0.00]

  bankrupt_since timestamptz
  bankrupt_resolved boolean [default: false]

  cooldown_until timestamptz

  eliminated_at timestamptz
  elimination_reason varchar(20)
  rank_at_elimination integer

  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    (status)
    (api_key)
    (status, bankrupt_since)
  }

  note: "Partial index intended: (status, bankrupt_since) WHERE status='BANKRUPT'"
}

// ============================================================================
// DIRECTIVES
// ============================================================================

Table directives {
  id uuid [pk, default: `gen_random_uuid()`]
  team_id uuid [not null, ref: > teams.id]

  raw_markdown text [not null]
  character_count integer

  extraction_confidence decimal(3,2)
  vibe_scores jsonb
  financial_impact jsonb
  board_feedback text
  public_headline varchar(120)

  status varchar(20) [default: 'PROCESSING']
  error_message text
  processing_time_ms integer

  created_at timestamptz [default: `now()`]
  completed_at timestamptz

  indexes {
    (team_id)
    (created_at)
  }
}

// ============================================================================
// ORDERS
// ============================================================================

Table orders {
  id uuid [pk, default: `gen_random_uuid()`]

  buyer_team_id uuid [ref: > teams.id]
  seller_team_id uuid [ref: > teams.id]
  target_team_id uuid [not null, ref: > teams.id]

  side varchar(4) [not null]
  shares integer [not null]
  shares_filled integer [default: 0]
  price_per_share decimal(10,2)

  order_type varchar(10) [default: 'MARKET']
  status varchar(10) [default: 'PENDING']

  failure_reason varchar(50)

  created_at timestamptz [default: `now()`]
  executed_at timestamptz
  expires_at timestamptz

  indexes {
    (buyer_team_id, status, created_at)
    (seller_team_id, status, created_at)
    (target_team_id, status, created_at)
    (status, created_at)
  }

  note: "Partial index intended: (status, created_at) WHERE status IN ('PENDING','PARTIAL')"
}

// ============================================================================
// ORDER FILLS
// ============================================================================

Table order_fills {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, ref: > orders.id]

  shares integer [not null]
  price_per_share decimal(10,2) [not null]
  total_value decimal(15,2) [not null]

  counterparty_order_id uuid [ref: > orders.id]

  filled_at timestamptz [default: `now()`]

  indexes {
    (order_id)
    (counterparty_order_id)
  }
}

// ============================================================================
// STOCK HOLDINGS
// ============================================================================

Table stock_holdings {
  id uuid [pk, default: `gen_random_uuid()`]

  owner_team_id uuid [not null, ref: > teams.id]
  target_team_id uuid [not null, ref: > teams.id]

  shares_owned integer [not null, default: 0]

  total_cost_basis decimal(15,2) [default: 0.00]
  average_cost_basis decimal(10,2)

  updated_at timestamptz [default: `now()`]

  indexes {
    (owner_team_id)
    (target_team_id)
    (owner_team_id, target_team_id) [unique]
  }
}

// ============================================================================
// CASH LEDGER
// ============================================================================

Table cash_ledger {
  id uuid [pk, default: `gen_random_uuid()`]
  team_id uuid [not null, ref: > teams.id]

  entry_type varchar(20) [not null]

  amount decimal(15,2) [not null]
  balance_after decimal(15,2) [not null]

  reference_type varchar(20)
  reference_id uuid

  description text

  created_at timestamptz [default: `now()`]

  indexes {
    (team_id, created_at)
    (reference_type, reference_id)
  }
}

// ============================================================================
// TRANSACTIONS
// ============================================================================

Table transactions {
  id uuid [pk, default: `gen_random_uuid()`]

  buyer_team_id uuid [ref: > teams.id]
  seller_team_id uuid [ref: > teams.id]
  target_team_id uuid [ref: > teams.id]

  shares integer [not null]
  price_per_share decimal(10,2) [not null]
  total_value decimal(15,2) [not null]

  transaction_type varchar(20)

  order_fill_id uuid [ref: > order_fills.id]

  executed_at timestamptz [default: `now()`]

  indexes {
    (target_team_id, executed_at)
    (buyer_team_id, executed_at)
    (seller_team_id, executed_at)
  }
}

// ============================================================================
// PRICE HISTORY
// ============================================================================

Table price_history {
  id uuid [pk, default: `gen_random_uuid()`]
  team_id uuid [not null, ref: > teams.id]

  price decimal(10,2) [not null]
  market_cap decimal(20,2) [not null]

  volume_24h integer [default: 0]
  net_flow decimal(5,4)

  vibe_multiplier decimal(5,4)
  consistency_score decimal(3,2)
  macro_sensitivity_score decimal(3,2)

  profit_component decimal(10,2)
  cash_component decimal(10,2)

  calculated_at timestamptz [default: `now()`]

  indexes {
    (team_id, calculated_at)
    (calculated_at)
  }
}

// ============================================================================
// MARKET NEWS
// ============================================================================

Table market_news {
  id uuid [pk, default: `gen_random_uuid()`]
  headline varchar(120) [not null]
  content text

  source_type varchar(20)
  source_team_id uuid [ref: > teams.id]

  sentiment_score decimal(3,2)
  affected_sectors jsonb
  affected_tickers jsonb

  strategy_fingerprint varchar(50)
  similar_news_count integer [default: 0]

  relevance_decay decimal(3,2) [default: 1.00]

  created_at timestamptz [default: `now()`]

  indexes {
    (created_at)
    (source_type, created_at)
    (source_team_id, created_at)
    (strategy_fingerprint, created_at)
  }

  note: "Partial indexes intended on source_team_id IS NOT NULL and strategy_fingerprint IS NOT NULL"
}

// ============================================================================
// LLM USAGE
// ============================================================================

Table llm_usage {
  id uuid [pk, default: `gen_random_uuid()`]
  team_id uuid [ref: > teams.id]
  directive_id uuid [ref: > directives.id]

  model varchar(50) [not null]

  input_tokens integer [not null]
  output_tokens integer [not null]
  total_tokens integer

  cost_usd decimal(10,6) [not null]

  latency_ms integer [not null]
  queue_time_ms integer
  processing_time_ms integer

  status varchar(20)
  error_message text

  created_at timestamptz [default: `now()`]

  indexes {
    (team_id, created_at)
    (status, created_at)
    (model, created_at)
  }
}

// ============================================================================
// GAME STATE
// ============================================================================

Table game_state {
  id integer [pk, default: 1]

  status varchar(20)

  started_at timestamptz
  paused_at timestamptz
  resumed_at timestamptz
  finished_at timestamptz

  current_round integer [default: 0]
  last_purge_at timestamptz
  next_purge_scheduled timestamptz
  teams_remaining integer

  llm_queue_depth integer [default: 0]
  total_llm_cost_usd decimal(10,2) [default: 0.00]

  updated_at timestamptz [default: `now()`]

  note: "Singleton enforced in SQL via CHECK (id=1) + unique index"
}

// ============================================================================
// ELIMINATION HISTORY
// ============================================================================

Table elimination_history {
  id uuid [pk, default: `gen_random_uuid()`]
  team_id uuid [not null, ref: > teams.id]

  round_number integer [not null]
  rank_at_elimination integer [not null]

  strategic_score decimal(5,4) [not null]
  market_cap_rank integer
  liquidity_rank integer

  reason varchar(20)

  final_cash decimal(15,2)
  final_stock_price decimal(10,2)
  final_market_cap decimal(20,2)
  final_liquidity decimal(15,2)

  eliminated_at timestamptz [default: `now()`]

  indexes {
    (round_number, rank_at_elimination)
    (team_id)
  }
}
